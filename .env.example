# Отдельные учётные данные контейнерной PostgreSQL.
# Имена роли и БД должны содержать только латинские буквы, цифры и подчёркивания.
POSTGRES_USER=sde_app
POSTGRES_DB=sde
# Задайте собственный случайный пароль. Пустое значение блокирует запуск.
# В .env используйте одинарные кавычки для буквального значения с $ и #.
# Пароль передаётся libpq через PGPASSWORD, кодировать его как URL не требуется.
POSTGRES_PASSWORD=
